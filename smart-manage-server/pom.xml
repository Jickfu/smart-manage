<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    <groupId>top.chekfu</groupId>
    <artifactId>smart-manage-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <properties>
        <java.version>21</java.version>
        <!--
            Spring Boot 未管理、由 Smart Manage 主动选择的第三方依赖版本。

            Spring Boot 已管理的版本不要在这里重复声明。
            当前会直接使用 Spring Boot parent 提供的：
            flyway.version
            postgresql.version
            lombok.version
            mockito.version
            angus-mail.version
            commons-pool2.version
            等版本属性。
        -->
        <archunit.version>1.5.0</archunit.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <druid.version>1.2.28</druid.version>
        <sa-token.version>1.45.0</sa-token.version>
        <springdoc.version>3.0.3</springdoc.version>
        <jetcache.version>2.8.0.RC</jetcache.version>
        <graalvm.version>24.2.2</graalvm.version>
        <commons-net.version>3.10.0</commons-net.version>
        <aws-sdk.version>2.46.8</aws-sdk.version>
        <tika.version>3.3.1</tika.version>
        <hutool.version>5.8.46</hutool.version>
        <argon2.version>2.12</argon2.version>
        <bouncycastle.version>1.84</bouncycastle.version>
        <http-message-signatures.version>1.8</http-message-signatures.version>
        <ipaddress.version>5.6.2</ipaddress.version>
        <tianai-captcha.version>1.5.5</tianai-captcha.version>
        <oshi.version>6.9.1</oshi.version>
        <fesod.version>2.0.2-incubating</fesod.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <commonmark.version>0.29.0</commonmark.version>
        <warm-flow.version>1.8.9</warm-flow.version>
    </properties>
    <modules>
        <module>platform</module>
        <module>domains</module>
        <module>app</module>
    </modules>
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Flyway -->
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <!-- flyway.version 继承自 Spring Boot parent -->
                <version>${flyway.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-database-postgresql</artifactId>
                        <version>${flyway.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- Java 编译与注解处理器 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <!-- lombok.version 继承自 Spring Boot parent -->
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        JDK 将禁止 Mockito 运行时自挂载，
                        测试进程必须显式加载 inline mock maker agent。
                        mockito.version 继承自 Spring Boot parent。
                    -->
                    <argLine>-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
