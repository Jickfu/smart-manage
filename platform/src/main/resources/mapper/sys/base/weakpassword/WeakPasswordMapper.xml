<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sm.domain.sys.base.weakpassword.mapper.WeakPasswordMapper">
    <select id="selectListPage" resultType="sm.domain.sys.base.weakpassword.model.vo.WeakPasswordVO">
        SELECT a.id, a.version, a.word, a.description, a.create_time, a.update_time
        FROM t_sys_weak_password a
        <where>
            <if test="form.keyword != null and form.keyword != ''">
                a.word LIKE CONCAT('%', #{form.keyword}, '%')
            </if>
            <include refid="sm.system.query.ListSqlQueryMapper.conditions"/>
        </where>
        <choose>
            <when test="listQuery.sortColumn != null">ORDER BY ${listQuery.sortColumn} ${listQuery.sortOrder}, a.id</when>
            <otherwise>ORDER BY a.word, a.id</otherwise>
        </choose>
    </select>
</mapper>
