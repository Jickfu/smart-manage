# 放入 Nginx http 上下文；替换域名、证书、内部 CA、证书名称及前端目录后 nginx -t。
# 默认同机双 JVM；多主机替换为内网 IP/端口，内部 HTTPS 必须实际启用且证书有效。
limit_req_zone $binary_remote_addr zone=smart_manage_api:10m rate=20r/s;
# 不使用 $request / $request_uri / $args，避免签名下载参数或其他敏感查询串落盘。
log_format smart_manage '$time_iso8601 $request_method $uri $status '
                        'upstream=$upstream_addr upstream_status=$upstream_status '
                        'request_time=$request_time';

upstream smart_manage_api {
    least_conn;
    # least_conn 不提供会话粘性；共享 Redis 保证请求可交给任一实例。
    server 127.0.0.1:8441 max_fails=1 fail_timeout=10s;
    server 127.0.0.1:8442 max_fails=1 fail_timeout=10s;
    keepalive 32;
}

server {
    listen 80;
    server_name smart-manage.example.com;
    access_log /var/log/nginx/smart-manage-access.log smart_manage;

    # 与 ACME 客户端的 webroot 保持一致；首次签发前先单独启用此 HTTP server。
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }

    location / {
        return 301 https://smart-manage.example.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name smart-manage.example.com;

    ssl_certificate /etc/letsencrypt/live/smart-manage.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/smart-manage.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/smart-manage/dist;
    index index.html;
    client_max_body_size 100m;
    access_log /var/log/nginx/smart-manage-access.log smart_manage;

    # frame-ancestors 只能通过 HTTP 响应头生效；HTML meta 中的同名指令会被浏览器忽略。
    # 若前端由另一个 server 提供，该 server 也必须配置这两个响应头。
    # 子 location 若自行设置 add_header，须同时重复这两个值，避免覆盖继承。
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;

    location /smart-manage-api/ {
        limit_req zone=smart_manage_api burst=40 nodelay;
        limit_req_status 429;
        # 不附加 URI，保持前后端共同声明的 API context path。
        proxy_pass https://smart_manage_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # 覆盖而不是追加客户端传入的地址头，防止伪造审计来源。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/nginx/tls/smart-manage-internal-ca.pem;
        # 所有 upstream 应用证书须包含此 DNS SAN；也可改为部署环境共同校验名称。
        proxy_ssl_name smart-manage-internal;
        proxy_ssl_server_name on;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        # 不加入 non_idempotent，避免已发送的 POST 写请求被透明重放。
        proxy_next_upstream error timeout http_502 http_503 http_504;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
