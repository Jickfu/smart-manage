# 示例仅展示应用代理边界；证书路径和域名由部署环境提供。
limit_req_zone $binary_remote_addr zone=smart_manage_api:10m rate=20r/s;

upstream smart_manage_api {
    least_conn;
    server 127.0.0.1:8081 max_fails=3 fail_timeout=10s;
    server 127.0.0.1:8082 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name smart-manage.example.com;

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/private.key;
    client_max_body_size 100m;

    location /smart-manage-api/ {
        limit_req zone=smart_manage_api burst=40 nodelay;
        proxy_pass http://smart_manage_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # 覆盖而不是追加客户端传入的地址头，防止伪造审计来源。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
