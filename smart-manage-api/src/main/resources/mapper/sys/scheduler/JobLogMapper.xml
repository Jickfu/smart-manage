<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="sm.domain.sys.scheduler.mapper.JobLogMapper">

    <!-- PostgreSQL DISTINCT ON 一次取得当前页每个任务的最近执行实例，避免列表 N+1。 -->
    <select id="selectLatestByJobIds" resultType="sm.domain.sys.scheduler.model.entity.JobLogEntity">
        SELECT DISTINCT ON (job_id)
            id,
            job_id,
            job_name,
            job_group,
            start_time,
            end_time,
            duration_ms,
            status,
            error_message,
            trace_id,
            create_time
        FROM t_sys_job_log
        WHERE job_id IN
        <foreach collection="jobIds" item="jobId" open="(" separator="," close=")">
            #{jobId}
        </foreach>
        ORDER BY job_id, start_time DESC NULLS LAST, id DESC
    </select>
</mapper>
