{
  "name": "smart-manage-design-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vitepress dev --host 127.0.0.1",
    "build": "vitepress build && node lib/verify-build.mjs",
    "preview": "vitepress preview --host 127.0.0.1",
    "test": "node --test lib/*.test.mjs",
    "format:check": "prettier --check .vitepress/config.mjs \".vitepress/theme/**/*.{mjs,css,vue}\" \"lib/*.mjs\" package.json pnpm-workspace.yaml"
  },
  "devDependencies": {
    "echarts": "6.1.0",
    "parse5": "7.3.0",
    "prettier": "3.8.3",
    "vitepress": "1.6.4",
    "vue": "3.5.24"
  }
}
